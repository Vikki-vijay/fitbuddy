APP_NAME=FitBuddy

DATABASE_URL=sqlite:///./fitbuddy.db

# Gemini API Key
# Add your real API key in .env
GEMINI_API_KEY=
# Gemini models
GEMINI_WORKOUT_MODEL=your_workout_model
GEMINI_FAST_MODEL=your_fast_model

# Set true for local testing without Gemini API
# Set false when you want to use Gemini
DEMO_MODE=true